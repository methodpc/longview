{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "longview",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "account_id": "442609eacf42a707e4a6512894bc12c4",

  // Static front end; /api/* goes to the Worker first.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },

  // Custom domain on your Cloudflare-managed zone. Change the subdomain here if you prefer another.
  "routes": [{ "pattern": "invest.cameronmedialab.com", "custom_domain": true }],

  "d1_databases": [
    { "binding": "DB", "database_name": "longview", "database_id": "ea082495-a64f-4193-8cfa-120a7ddc9ced" }
  ],

  // Every minute: Finnhub mode refreshes a slice of quotes/fundamentals; FMP mode acts every 10th minute.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    // "finnhub" (free beta) or "fmp" (Premium). The matching API key secret must be set.
    "DATA_PROVIDER": "finnhub",
    // Finnhub calls per cron minute (free plan allows 60/min; the rest is left for people browsing).
    "FINNHUB_BUDGET": "40",
    // FMP: symbols refreshed per run. 7 fits the Workers Free plan (50 subrequests per run); on Workers Paid use 40.
    "REFRESH_BATCH": "7"
  },
  "observability": { "enabled": true }

  // Secrets (not in this file):
  //   npx wrangler secret put FINNHUB_API_KEY      <- beta data (free plan)
  //   npx wrangler secret put TWELVEDATA_API_KEY   <- optional, free plan; enables price charts in Finnhub mode
  //   npx wrangler secret put FMP_API_KEY          <- later, with DATA_PROVIDER "fmp"
  //   npx wrangler secret put ADMIN_TOKEN     <- optional, lets you trigger /api/admin/refresh
}
